# Rendered at container start by the nginx image's envsubst step, which only
# substitutes variables that are set in the environment, so nginx's own $uri and
# $host survive untouched. BACKEND_URL defaults to http://backend:8000 (Dockerfile.prod).
server {
    listen 8080;
    root /usr/share/nginx/html;

    # /api/health -> ${BACKEND_URL}/health: the trailing slash on proxy_pass strips /api.
    location /api/ {
        proxy_pass ${BACKEND_URL}/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Client-side routes fall back to the SPA shell.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
