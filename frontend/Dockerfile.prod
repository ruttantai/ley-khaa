# Production image for Kubernetes: the built dashboard served by nginx, with
# /api/ proxied to the backend so the browser only ever talks to one origin.
# The dev image (frontend/Dockerfile, used by docker-compose.yml) is unchanged.
FROM node:20-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# Relative, so the bundle works behind any host name; nginx below owns /api/.
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.29-alpine
ENV BACKEND_URL=http://backend:8000
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
